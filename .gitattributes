# Auto-detect text files and normalize line endings to LF (Linux/Mac/Git standard)
* text=auto eol=lf

# Explicitly ensure JavaScript, JSON, Markdown, Python, HTML, CSS, YAML use LF
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.py text eol=lf
*.html text eol=lf
*.css text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.txt text eol=lf
Dockerfile text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Keep Windows-specific scripts with CRLF if needed
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.joblib binary
