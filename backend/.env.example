# Backend Port
PORT=5000

# PostgreSQL / Supabase Database Connection String
# For Supabase: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# For Local: postgresql://postgres:postgres@localhost:5432/sih_block_planning
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sih_block_planning

# Supabase API Credentials (from Supabase Dashboard -> Settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# JWT Secret for Railway Officer Sessions
JWT_SECRET=sih_railway_secret_key_2026

# Python FastAPI Machine Learning Service URL
ML_SERVICE_URL=http://localhost:8000

# Anthropic Claude API Key (for automated block summary & conflict mitigation notes)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Indian Railways / RapidAPI Key (to track live train schedules and busy slots)
RAILWAY_API_KEY=your_railway_api_key_here
RAILWAY_API_HOST=irctc1.p.rapidapi.com

# Groq API Key (for AI-powered block planning optimization)
GROQ_API_KEY=your_groq_api_key_here
